{
  "name": "gcd-ai-radar-internet",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker that serves the GCD RADAR home page's live internet band from Cloudflare Radar, cached for five minutes.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --config ./vitest.config.ts",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^10.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
