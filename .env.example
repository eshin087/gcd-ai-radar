# Copy to .env for local collector runs. Never commit real keys.
# Required for classification (free tier, Google AI Studio):
GEMINI_API_KEY=
# Optional fallback classifier (free tier):
GROQ_API_KEY=
# Optional: raises NVD rate limit from 5 to 50 requests per 30 s:
NVD_API_KEY=
# Optional: Cloudflare API token with Account > Radar > Read:
CLOUDFLARE_RADAR_TOKEN=
# Optional: Vercel deploy hook URL, pinged after each data commit:
VERCEL_DEPLOY_HOOK=
# Site URL used for canonical links, OG images and the RSS feed.
# Falls back to Vercel's VERCEL_PROJECT_PRODUCTION_URL at build time.
NEXT_PUBLIC_SITE_URL=
# Use the synthetic stub dataset while data/incidents.json is nearly empty.
ALLOW_STUB=1
